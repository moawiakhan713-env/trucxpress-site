# TrucXpress — canonical host and old WordPress URLs
<IfModule mod_rewrite.c>
  RewriteEngine On

  # one canonical address: https://trucxpress.com
  RewriteCond %{HTTP_HOST} ^www\.trucxpress\.com$ [NC]
  RewriteRule ^(.*)$ https://trucxpress.com/$1 [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://trucxpress.com/$1 [R=301,L]

  # pages that Google indexed on the old WordPress site
  RewriteRule ^our-services/?$ https://trucxpress.com/services [R=301,L,NC]
  RewriteRule ^about/?$ https://trucxpress.com/about-us [R=301,L,NC]
  RewriteRule ^contact-us/?$ https://trucxpress.com/contact [R=301,L,NC]
  RewriteRule ^blogs/?$ https://trucxpress.com/blog [R=301,L,NC]
  RewriteRule ^faqs?/?$ https://trucxpress.com/#faq [R=301,L,NC,NE]
  RewriteRule ^(home|feed)/?$ https://trucxpress.com/ [R=301,L,NC]
  # earlier addresses of the equipment pages: /flatbed-dispatch -> /services/flatbed
  RewriteRule ^(dry-van|reefer|flatbed|step-deck|power-only|box-truck|hotshot)-dispatch(\.html)?/?$ https://trucxpress.com/services/$1 [R=301,L,NC]

  # clean URLs: /index.html -> /, /services-flatbed.html -> /services/flatbed,
  # /contact.html -> /contact
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ https://trucxpress.com/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+services-([a-z0-9-]+)(\.html)?[\s?] [NC]
  RewriteRule ^ https://trucxpress.com/services/%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
  RewriteRule ^ https://trucxpress.com/%1 [R=301,L]
  # no trailing slash on pages: /services/ -> /services
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9/-]+)/$ https://trucxpress.com/$1 [R=301,L,NC]
  # serve /services/flatbed from services-flatbed.html, /contact from contact.html
  RewriteRule ^services/([a-z0-9-]+)$ services-$1.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z0-9-]+)$ $1.html [L]
</IfModule>

# TrucXpress — cache policy
# HTML/CSS/JS always revalidate so deploys show up immediately;
# fonts, images and 3D models are immutable and cache long.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2|svg|png|jpg|jpeg|webp|glb|wasm)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# Compress text assets (Three.js, CSS, HTML, decoder) on the fly
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType model/gltf-binary .glb
</IfModule>

# Mail settings file (if the owner puts it here instead of above public_html)
<Files "send-config.php">
  Require all denied
</Files>
